APP_ENV=local
LOG_LEVEL=INFO

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

SPRING_BASE_URL=http://localhost:8080
VITAMATE_WORKER_TOKEN=your-worker-token-here
BIDDING_WORKER_TOKEN=your-bidding-worker-token-here

REDIS_URL=redis://localhost:6379/0
VITAMATE_STREAM_KEY=vitamate:analysis:jobs
VITAMATE_CONSUMER_GROUP=vitamate-python-workers
VITAMATE_CONSUMER_NAME=vitamate-worker-local
VITAMATE_AI_FALLBACK_ENABLED=false

BIDDING_SUMMARY_STREAM_KEY=bidding:summary:jobs
BIDDING_SUMMARY_CONSUMER_GROUP=bidding-summary-workers
BIDDING_SUMMARY_CONSUMER_NAME=bidding-summary-worker-local
BIDDING_SUMMARY_CLAIM_MIN_IDLE_MS=60000
BIDDING_SUMMARY_CLAIM_COUNT=10

BIDDING_REVIEW_STREAM_KEY=bidding:review:jobs
BIDDING_REVIEW_CONSUMER_GROUP=bidding-review-workers
BIDDING_REVIEW_CONSUMER_NAME=bidding-review-worker-local
BIDDING_REVIEW_CLAIM_MIN_IDLE_MS=60000
BIDDING_REVIEW_CLAIM_COUNT=10

VITAMATE_FILE_INDEX_STREAM_KEY=vitamate:file-index:jobs
VITAMATE_FILE_INDEX_CONSUMER_GROUP=vitamate-file-index-workers
VITAMATE_FILE_INDEX_CONSUMER_NAME=vitamate-file-index-worker-local
